<?xml version="1.0"?>
<!-- HomeBot: small differential-drive robot with a 360 deg lidar.
     Gazebo Harmonic plugins: DiffDrive (/cmd_vel), OdometryPublisher (/odom, /tf),
     JointStatePublisher (/joint_states), gpu_lidar (/scan). -->
<robot name="home_bot">

  <material name="body"><color rgba="0.95 0.45 0.10 1"/></material>
  <material name="dark"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="grey"><color rgba="0.50 0.50 0.50 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.40 0.30 0.10"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.40 0.30 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07"/>
      <mass value="4.0"/>
      <inertia ixx="0.0333" ixy="0" ixz="0" iyy="0.0567" iyz="0" izz="0.0833"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Drive wheels -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0004"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.18 0.07"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0004"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.18 0.07"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Frictionless casters front and back -->
  <link name="front_caster">
    <visual><geometry><sphere radius="0.03"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/><child link="front_caster"/>
    <origin xyz="0.16 0 0.03"/>
  </joint>
  <link name="rear_caster">
    <visual><geometry><sphere radius="0.03"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/><child link="rear_caster"/>
    <origin xyz="-0.16 0 0.03"/>
  </joint>

  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision><geometry><cylinder radius="0.05" length="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.05 0 0.145"/>
  </joint>

  <!-- Camera on a short mast (eye height ~0.6 m, tilted 10 deg down) -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry><cylinder radius="0.015" length="0.4"/></geometry>
      <material name="grey"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/><child link="mast_link"/>
    <origin xyz="-0.05 0 0.12"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.10 0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/><child link="camera_link"/>
    <origin xyz="0.03 0 0.42" rpy="0 0.17 0"/>
  </joint>
  <!-- REP-103 optical frame (z forward, x right, y down) for image consumers -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_link"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== Gazebo (Harmonic) ===================== -->
  <gazebo reference="front_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="rear_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.07</wheel_radius>
      <topic>cmd_vel</topic>
      <!-- wheel odometry kept on separate topics; /odom comes from OdometryPublisher -->
      <odom_topic>wheel_odom</odom_topic>
      <tf_topic>wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image</topic>
      <camera_info_topic>camera/camera_info</camera_info_topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
